# ─── Core ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ─── Database (Render provides this automatically) ───────────────
DATABASE_URL=postgresql://aegis:password@localhost:5432/aegis_ai

# ─── Redis (Render provides this automatically) ─────────────────
REDIS_URL=redis://127.0.0.1:6379

# ─── Session & Security ─────────────────────────────────────────
SESSION_SECRET=change-me-to-a-random-string
FIELD_ENCRYPTION_KEY=change-me-to-a-random-string

# ─── URLs ────────────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend.onrender.com
BACKEND_URL=https://your-backend.onrender.com
CORS_ORIGIN=https://your-frontend.onrender.com

# ─── OpenAI (required for AI features) ──────────────────────────
OPENAI_API_KEY=sk-...

# ─── Google OAuth (required for authentication) ─────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Google Places API (optional — service provider search) ─────
GOOGLE_PLACES_API_KEY=

# ─── Email / SMTP (optional — notifications, vendor reminders) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# ─── Sarvam AI (optional — Indian language voice/vision) ────────
SARVAM_API_KEY=
SARVAM_VISION_URL=https://api.sarvam.ai/vision
SARVAM_VOICE_URL=https://api.sarvam.ai/voice

# ─── ULI India SME Lending (optional) ───────────────────────────
ULI_BASE_URL=https://sandbox.uli.org.in
ULI_CLIENT_ID=
ULI_CLIENT_SECRET=

# ─── DPDP Compliance (optional) ─────────────────────────────────
DPDP_APPROVED_COUNTRIES=IN
DPDP_RETENTION_DAYS=90

# ─── Frontend (build-time only) ─────────────────────────────────
# Set to empty string when frontend is served from the same domain
# via Render Static Site rewrite rules, or set to backend URL for
# cross-origin setups.
VITE_API_URL=
